# DeepSeek API Settings（必需：复制为 .env 后填写；本版本已移除无 Key 兜底）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 代码/讲稿生成较长，建议 120s
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=8192

# Edge-TTS Settings
# Recommended voices: zh-CN-YunxiNeural, zh-CN-XiaoxiaoNeural, zh-CN-YunjianNeural
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=-8%
TTS_VOLUME=+0%

# 每页旁白后的刻意停顿（秒）
PAUSE_BUFFER=2.2
# 单节最多生成多少页
MAX_SLIDES_PER_SECTION=10
